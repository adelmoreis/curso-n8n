        "url": "=https://chatwoot.agente3d.net/api/v1/accounts/{{ $('Classificar').first().json.account_id }}/conversations/{{ $('Classificar').first().json.conversation_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Cliente pediu atendimento humano (curso N8N). Assuma a conversa.', message_type: 'outgoing', private: true }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
