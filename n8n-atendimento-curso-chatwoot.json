    {
      "id": "4",
      "name": "Classificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst cfg = $input.first().json;\nconst t = (b.content || '').toLowerCase();\nlet intent = 'duvida';\nif (/(humano|atendente|pessoa|falar com algu)/.test(t)) intent = 'humano';\nelse if (/pix/.test(t) && /(pagar|pagamento)/.test(t)) intent = 'pix';\nelse if (/cart[aã]o/.test(t) && /(pagar|pagamento)/.test(t)) intent = 'cartao';\nelse if (/inscrever/.test(t)) intent = 'inscricao';\nreturn [{ json: {\n  intent,\n  texto: b.content || '',\n  nome: (b.sender && b.sender.name) || '',\n  conversation_id: b.conversation.id,\n  account_id: b.account.id,\n  linkPix: cfg.linkPix,\n  linkCartao: cfg.linkCartao\n}}];"
      }
    },
