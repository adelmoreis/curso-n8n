{
  "name": "Curso n8n - Atendimento WhatsApp (Chatwoot + IA)",
  "nodes": [
    {
      "id": "1",
      "name": "Chatwoot (message_created)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "curso-whatsapp",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "linkPix",
              "value": "https://pag.ae/82kKqTCnM",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "linkCartao",
              "value": "https://pag.ae/82kKi4Z2J",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "É cliente e sem humano?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "message_created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.message_type }}",
              "rightValue": "incoming",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ ($json.body.conversation.labels || []).includes('humano') }}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Classificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst cfg = $input.first().json;\nconst t = (b.content || '').toLowerCase();\nlet intent = 'duvida';\nif (/(humano|atendente|pessoa|falar com algu)/.test(t)) intent = 'humano';\nelse if (/pix/.test(t) && /(pagar|pagamento)/.test(t)) intent = 'pix';\nelse if (/cart[aã]o/.test(t) && /(pagar|pagamento)/.test(t)) intent = 'cartao';\nelse if (/inscrever/.test(t)) intent = 'inscricao';\nreturn [{ json: {\n  intent,\n  texto: b.content || '',\n  nome: (b.sender && b.sender.name) || '',\n  conversation_id: b.conversation.id,\n  account_id: b.account.id,\n  linkPix: cfg.linkPix,\n  linkCartao: cfg.linkCartao\n}}];"
      }
    },
    {
      "id": "5",
      "name": "Qual a intenção?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "pix",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "pix"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "cartao",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "cartao"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "inscricao",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "inscricao"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "humano",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "humano"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "duvida"
        }
      }
    },
    {
      "id": "6",
      "name": "Msg Pix",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        40
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "resposta",
              "type": "string",
              "value": "=Oi{{ $json.nome ? ', ' + $json.nome.split(' ')[0] : '' }}! Pagamento no Pix: R$ 88,20 à vista (10% de desconto, preço de lançamento dos 100 primeiros).\\n\\nLink: {{ $json.linkPix }}\\n\\nAssim que o pagamento confirmar, você recebe login e senha por e-mail e WhatsApp."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7",
      "name": "Msg Cartão",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        180
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "m2",
              "name": "resposta",
              "type": "string",
              "value": "=Oi{{ $json.nome ? ', ' + $json.nome.split(' ')[0] : '' }}! No cartão: R$ 98 em até 6x de R$ 16,33 (preço de lançamento dos 100 primeiros).\\n\\nLink: {{ $json.linkCartao }}\\n\\nAssim que o pagamento confirmar, você recebe login e senha por e-mail e WhatsApp."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8",
      "name": "Msg Inscrição",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "m3",
              "name": "resposta",
              "type": "string",
              "value": "=Oi{{ $json.nome ? ', ' + $json.nome.split(' ')[0] : '' }}! Que bom ter você por aqui. 🎉\\n\\nÉ a turma de lançamento do N8N Academia Agente3d, só para os 100 primeiros: R$ 98 em até 6x de R$ 16,33, ou R$ 88,20 à vista no Pix. Inclui 3 meses de acesso, acompanhamento com a turma, grupo no WhatsApp e Telegram e a apostila completa.\\n\\nPrefere pagar no *Pix* ou no *cartão*? É só me dizer."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9",
      "name": "IA responde dúvida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.3, max_tokens: 350, messages: [ { role: 'system', content: \"Você é o assistente oficial do Curso Prático de n8n e Agente3D (Adelmo Reis em Jacobina - BA). Seu foco é 100% EXCLUSIVO no curso de n8n e nas automações. É TERMINANTEMENTE PROIBIDO responder perguntas sobre religião, Bíblia (ex: Adão e Eva), fofocas ou conhecimentos gerais. Se perguntarem algo fora do tema, NUNCA responda a curiosidade: diga com simpatia que é focado no Curso de n8n e convide a conhecer nossa apostila ou curso. FATOS OFICIAIS: Curso prático para iniciantes do zero, 4 Mundos, simulador, quizzes, certificado. Preço: R$ 98 em até 6x no cartão ou R$ 88,20 no Pix com cupom VIP10. Página de vendas: https://curson8n.agente3d.net/pagina-de-vendas.html. Plataforma do aluno com Módulo 1 grátis: https://curson8n.agente3d.net/. Agente3D: https://www.agente3d.net/. Se pedirem humano diga que vai chamar o Adelmo e termine com [HUMANO]. Responda em no máximo 3 linhas.\" }, { role: 'user', content: $json.texto } ] }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "OpenAI (Authorization Bearer)"
        }
      }
    },
    {
      "id": "10",
      "name": "Tratar IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        520
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst base = $('Classificar').first().json;\nlet txt = (r.choices && r.choices[0] && r.choices[0].message.content || '').trim();\nconst humano = txt.includes('[HUMANO]');\ntxt = txt.replace('[HUMANO]', '').trim();\nif (!txt) txt = 'Vou chamar uma pessoa da equipe para te ajudar.';\nreturn [{ json: { ...base, resposta: txt, humano } }];"
      }
    },
    {
      "id": "11",
      "name": "IA pediu humano?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
        520
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.humano }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "12",
      "name": "Msg Humano",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
