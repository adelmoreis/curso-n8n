    {
      "id": "10",
      "name": "Tratar IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        520
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst base = $('Classificar').first().json;\nlet txt = (r.choices && r.choices[0] && r.choices[0].message.content || '').trim();\nconst humano = txt.includes('[HUMANO]');\ntxt = txt.replace('[HUMANO]', '').trim();\nif (!txt) txt = 'Vou chamar uma pessoa da equipe para te ajudar.';\nreturn [{ json: { ...base, resposta: txt, humano } }];"
      }
    },
